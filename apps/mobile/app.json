{
  "expo": {
    "name": "Novi",
    "slug": "novi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "novi",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.estheredi.novi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F05A1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.estheredi.novi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Novi uses the camera only to read the code on your ID card."
        }
      ]
    ]
  }
}
