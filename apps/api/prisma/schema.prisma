generator client {
    provider            = "prisma-client"
    output              = "../src/generated/prisma"
    moduleFormat        = "esm"
    importFileExtension = "js"
  }

  datasource db {
    provider = "postgresql"
  }


  //----------------Value Lists-------------------------


  //Interface languages ; follow ISO 639-1 (ee = Ewe)

  enum Language {

    EN 
    FR 
    EE
  }

  // SMS code to be sent 

  enum OtpPurpose {
    SIGN_UP
    NEW_DEVICE
    PIN_RESET
  }


// Member agrees to

enum ConsentType {
  ID_CHECK //her details may be sent to ANID FOR verification
  CREDIT_DATA_USE // her records may be used for credit not tax
  TERMS           // the Novi rules
}

// Where a group is in its life (D29). The API checks this before every
// action and refuses anything the state does not allow.
enum GroupState {
  DRAFT     // being set up; rules not yet sent
  PROPOSED  // rules sent; members deciding
  STARTING  // waiting for the MFI to open the account
  ACTIVE    // account open; contributions and payouts running
  COMPLETED // every member has received the pot once
  CANCELLED // stopped before any money moved
}

// How often members pay in.
enum Frequency {
  DAILY // D92: Monday to Saturday, as market traders pay
  WEEKLY
  MONTHLY
}

// How the order of payouts is chosen.
enum PayoutOrder {
  DRAWN // Novi draws it at random when the group starts (default)
  FIXED // the organiser sets it, and everyone accepts it with the rules
}

// A member's role inside one group. Not an account type: the same person
// can organise one group and be an ordinary member of another.
enum MemberRole {
  ORGANISER
  MEMBER
}

// The mobile money services FedaPay can collect from in Togo (FedaPay
// "send now" modes moov_tg and togocel). Flooz is Moov Africa's; Mixx by Yas
// was T-Money, run by Togocel.
enum MobileOperator {
  MOOV_TG
  TOGOCEL
}

// Where one payment attempt is.
enum ContributionStatus {
  PENDING // asked; waiting for her to confirm on her phone
  PAID    // the provider confirmed the money moved
  FAILED  // declined, cancelled, or not confirmed in time
}

// Where one round's payout is (Sprint 4).
enum PayoutStatus {
  HELD    // due, but the pot is not full: nothing is sent short (D48)
  READY   // due and full: waiting for the MFI officer to release it (D63)
  SENDING // Novi has asked the MFI to send it
  SENT    // the MFI accepted the instruction; waiting for its confirmation
  PAID    // the MFI confirmed the money reached her wallet
  FAILED  // the MFI refused or did not answer; tried again on the next run
}

// What a ledger line records.
enum LedgerEntryType {
  CONTRIBUTION // money in from one member
  PAYOUT       // money out to the member whose turn it is (Sprint 4)
  CORRECTION   // fixes an earlier line, which is never edited (D5)
  // The group's solidarity reserve (D68):
  RESERVE_IN     // the reserve's share of one contribution
  RESERVE_COVER  // the reserve pays a late member's share so the pot leaves full
  RESERVE_REPAY  // her late payment refills the reserve
  RESERVE_RETURN // what is left at the end of the cycle, back to a member
  // D88: a small advance from the fund to a member, repaid from her pot.
  RESERVE_ADVANCE       // the fund sends the advance to her wallet
  RESERVE_ADVANCE_REPAY // her pot pays it back
}

// Where one seat is in its life.
// D69: why a member left a started group before the end of its cycle.
enum ExitReason {
  DEATH // recorded by the MFI officer, on a death certificate
  LEFT  // she stopped taking part; what she owes stays owed
}

enum SeatState {
  INVITED   // invitation sent, no answer yet
  ACCEPTED  // said yes to a version of the rules (see acceptedVersion)
  COUNTERED // asked for a change, with a note
  DECLINED  // said no; the seat is free
  REMOVED   // the organiser withdrew the invitation
}


//----------------Members and access------------


// A verified member. An account exists only after a successful identity check.


model User {
  id                String    @id @default(uuid())
  phone             String    @unique // +228 followed by 8 digits
  // D69: the person she trusts to receive what she is owed if she dies. Never
  // contacted while she is alive; used only by the MFI, on a death certificate.
  nextOfKinName     String?
  nextOfKinPhone    String?
  nextOfKinRelation String?
  legalName         String    // exactly as on the ID record; used on the ACEV
  displayName       String    // what her group sees; she can change it
  market            String? // only in the case the trades in a market
  area              String
  language          Language
  pinHash           String    // argon2id; the PIN itself is never stored
  niuKeyedHash      String    @unique // stops one person opening two accounts
  idVerifiedAt      DateTime
  failedPinAttempts Int       @default(0)
  lockoutLevel      Int       @default(0) // each lockout lasts longer than the last
  lockedUntil       DateTime?
  pinChangedAt      DateTime? // stamps issued before this moment cannot reset the PIN again
  closedAt          DateTime? // D69: recorded deceased by the MFI; no one can log in
  notifyChat        Boolean   @default(true) // D79: phone notifications for chat messages (money ones always go)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  devices     Device[]
  sessions    Session[]
  consents    Consent[]
  auditEvents AuditEvent[]

  organisedGroups Group[]        @relation("GroupOrganiser")
  memberships     Membership[]   @relation("SeatHolder")
  invitesSent     Membership[]   @relation("SeatInviter")
  rulesProposed   RulesVersion[]
  phoneInvites    Invite[]
  roundsReceived  Round[]        @relation("RoundBeneficiary")
  payoutsReceived Payout[]
  recordShares    RecordShare[]
  reminders       Reminder[]
  contributions   Contribution[]
  ledgerEntries   LedgerEntry[]
  reserveCovers   ReserveCover[]
  reserveReturns  ReserveReturn[]
  messages        GroupMessage[]  @relation("MessageAuthor")
  messagesHidden  GroupMessage[]  @relation("MessageHider")
  meetingsCreated GroupMeeting[]
  swapsAsked      TurnSwap[]      @relation("SwapRequester")
  swapsReceived   TurnSwap[]      @relation("SwapPartner")
  advances        Advance[]       @relation("AdvanceBorrower")
  loanRequests    LoanRequest[]
  meetingsJoined  MeetingAttendance[]

  @@map("users")
}

// A phone the member has trusted, identified by the app's installation ID.
model Device {
  id             String   @id @default(uuid())
  userId         String
  installationId String
  trustedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  untrustedAt    DateTime? // D69: her number changed; this phone needs the SMS code again
  pushToken      String?   // D79: Expo's address for notifications to this phone

  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]

  @@unique([userId, installationId])
  @@map("devices")
}

// One logged-in session. Revoking it logs the member out on that device.
model Session {
  id               String    @id @default(uuid())
  userId           String
  deviceId         String
  refreshTokenHash String    @unique // the token itself is never stored
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?   // ROTATED, LOGOUT, PIN_RESET, REUSE_DETECTED, PHONE_CHANGED or DECEASED
  createdAt        DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// One SMS code sent to a phone number.
model OtpChallenge {
  id         String     @id @default(uuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String     // the code itself is never stored
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

// One identity check attempt. Exists before any account, so it is not linked
// to a user; used to block an NIU after 3 failures in 24 hours.
model IdentityCheck {
  id           String   @id @default(uuid())
  niuKeyedHash String
  phone        String
  matched      Boolean
  createdAt    DateTime @default(now())

  @@index([niuKeyedHash, createdAt])
  @@map("identity_checks")
}

// What a member agreed to, and to which version of the text.
model Consent {
  id         String      @id @default(uuid())
  userId     String
  type       ConsentType
  version    String
  acceptedAt DateTime

  user User @relation(fields: [userId], references: [id])

  @@map("consents")
}

// Append-only record of important events: who did what, and when.
model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?  // empty for events before an account exists
  type      String   // e.g. USER_REGISTERED, PIN_LOCKED
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_events")
}


//----------------Groups----------------------------

// A partner microfinance institution. It holds each group's money in an
// account it opens; Novi never holds money (D2).
model Mfi {
  id        String   @id @default(uuid())
  code      String   @unique // short name used in code and logs, e.g. FUCEC
  name      String   // shown to members on every money screen
  // D105: a full pot up to this amount leaves on its due date without an
  // officer; above it, two different officers approve. Set by the admin;
  // empty (null) turns it off: one officer releases every pot (D63).
  autoReleaseFcfa Int? @default(50000)
  // D102: the MFI's own FedaPay account. Members' payments go into it and
  // pots leave from it, so the money is the MFI's, never Novi's. Both keys
  // are stored encrypted (D101) and never shown again once saved.
  fedapaySecretKey     String?
  fedapayWebhookSecret String?
  fedapayLive          Boolean   @default(false) // false: FedaPay's sandbox
  fedapayConnectedAt   DateTime?
  fedapayPayouts       Boolean   @default(true) // false: pots go through the MFI stand-in (D49), e.g. if the sandbox refuses payouts
  createdAt DateTime @default(now())

  groups        Group[]
  rulesVersions RulesVersion[]
  staff         StaffUser[]
  recordShares RecordShare[]
  loanRequests LoanRequest[]
  creditPolicy CreditPolicy?

  @@map("mfis")
}

// A savings group. The rules themselves live in RulesVersion: the group only
// points to the version currently in force, so no agreed version is ever lost.
model Group {
  id             String     @id @default(uuid())
  name           String
  state          GroupState @default(DRAFT)
  currentVersion Int        @default(1) // the rules version members must accept
  mfiId          String
  organiserId    String
  mfiAccountRef  String?    // the MFI's reference for the group account, once opened
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  // D72: a new cycle with the same members is a new group, linked to the one before.
  cycleNumber     Int        @default(1)
  previousGroupId String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  previousCycle Group?         @relation("NextCycle", fields: [previousGroupId], references: [id])
  nextCycle     Group?         @relation("NextCycle")
  mfi           Mfi            @relation(fields: [mfiId], references: [id])
  organiser     User           @relation("GroupOrganiser", fields: [organiserId], references: [id])
  rulesVersions RulesVersion[]
  memberships   Membership[]
  invites       Invite[]
  rounds        Round[]
  ledgerEntries LedgerEntry[]
  reserveReturns ReserveReturn[]
  messages       GroupMessage[]
  meetings       GroupMeeting[]
  turnSwaps      TurnSwap[]
  advances       Advance[]

  @@index([state])
  @@map("groups")
}

// One version of a group's rules. Never edited: a change creates the next
// version, and every acceptance falls back to "not yet" (D29).
model RulesVersion {
  id           String      @id @default(uuid())
  groupId      String
  version      Int
  amountFcfa   Int         // each member's contribution, whole FCFA (D4)
  frequency    Frequency
  dueDay       Int         // WEEKLY: 1 (Monday) to 7 (Sunday); MONTHLY: 1 to 28
  size         Int         // number of members, 3 to 15 (D28)
  payoutOrder  PayoutOrder @default(DRAWN)
  fixedOrder   String[]    @default([]) // FIXED only: member IDs, first to be paid first (D41)
  // D95: where the group's money is kept is part of the rules, so every
  // member accepts it with the rest. Group.mfiId follows the version in force.
  mfiId        String
  proposedById String
  createdAt    DateTime    @default(now())

  group      Group @relation(fields: [groupId], references: [id])
  mfi        Mfi   @relation(fields: [mfiId], references: [id])
  proposedBy User  @relation(fields: [proposedById], references: [id])

  @@unique([groupId, version])
  @@map("rules_versions")
}

// One seat in one group: who holds it, their role, and their answer to the rules.
model Membership {
  id              String     @id @default(uuid())
  groupId         String
  userId          String
  role            MemberRole @default(MEMBER)
  state           SeatState  @default(INVITED)
  acceptedVersion Int?       // the rules version she accepted; must equal the group's current version
  counterNote     String?    // what she asked to change, when COUNTERED
  payoutPosition  Int?       // her turn in the payout order, set when the group starts
  invitedById     String?    // empty for the organiser's own seat
  respondedAt     DateTime?
  // D69: she left the started group; her pot and her share of the reserve
  // then go to exitPayoutPhone (her next of kin, after a death).
  exitReason      ExitReason?
  exitedAt        DateTime?
  exitPayoutPhone String?
  chatReadAt      DateTime?  // D70: the last time she opened the group's chat
  chatPushedAt    DateTime?  // D79: the last chat notification, at most one an hour
  continueAnswer  Boolean?   // D80: at the end of the cycle, does she want to go again?
  continueAt      DateTime?
  // D84: she agreed, when joining, that the MFI may see her Novi record
  // (cycles finished, payments on time, caisse debt) to validate the group.
  shareConsentAt  DateTime?
  defaultedAt     DateTime?  // D104: a second missed turn without repaying
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  group     Group @relation(fields: [groupId], references: [id])
  user      User  @relation("SeatHolder", fields: [userId], references: [id])
  invitedBy User? @relation("SeatInviter", fields: [invitedById], references: [id])

  @@unique([groupId, userId]) // one seat per person per group
  @@index([userId, state])    // her groups, for the 3-group limit (D26)
  @@map("memberships")
}

// An invitation sent to a phone number. It holds a place in the group until
// the person answers; only then does she get a seat (Membership). Inviting by
// number works the same whether or not the number has a Novi account, so the
// organiser never learns who uses Novi (D38).
model Invite {
  id          String    @id @default(uuid())
  groupId     String
  phone       String    // +228 followed by 8 digits
  invitedById String
  createdAt   DateTime  @default(now())
  answeredAt  DateTime? // she accepted, countered or declined: the invite is used
  cancelledAt DateTime? // the organiser withdrew it

  group     Group @relation(fields: [groupId], references: [id])
  invitedBy User  @relation(fields: [invitedById], references: [id])

  @@unique([groupId, phone]) // one invitation per number per group
  @@index([phone])           // her invitations, found by her verified number
  @@map("invites")
}


//----------------Money in (Sprint 3)----------------------------

// One turn of the cycle: the day everyone pays, and who receives the pot.
// A group of 10 has 10 rounds. They are created when the group becomes
// ACTIVE; round 1 is due on the first due day after that (D44).
model Round {
  id            String   @id @default(uuid())
  groupId       String
  number        Int      // 1 for the first turn
  dueDate       DateTime @db.Date // Togo uses GMT all year, so a date needs no time zone
  beneficiaryId String   // the member whose payout position is this number
  createdAt     DateTime @default(now())

  group         Group          @relation(fields: [groupId], references: [id])
  beneficiary   User           @relation("RoundBeneficiary", fields: [beneficiaryId], references: [id])
  contributions Contribution[]
  ledgerEntries LedgerEntry[]
  payout        Payout?
  reminders     Reminder[]
  reserveCovers ReserveCover[]

  @@unique([groupId, number])
  @@map("rounds")
}

// One member's payment for one round, as a request to the payment provider.
// This row changes (PENDING, then PAID or FAILED); the money itself is
// recorded in the ledger, which never changes (D5).
model Contribution {
  id          String             @id @default(uuid())
  roundId     String
  userId      String
  amountFcfa  Int                // the group's contribution in force when she paid (D4), plus her advance in round 1
  advanceFcfa Int                @default(0) // D103: the part of round 1's payment that is her advance, not the pot
  reportedAt  DateTime?          // she says the money left her account, though the payment is not confirmed
  paymentAccountMfiId String? // D102: the MFI whose FedaPay account took this payment; empty: Novi's demo account
  // D105: the officer's answer after checking the operator's statement.
  reportCheckedById String?
  reportRejectedAt  DateTime? // not found: she pays again
  operator    MobileOperator
  payerPhone  String             // her verified Novi number: Novi collects only from her own wallet
  status      ContributionStatus @default(PENDING)
  provider    String             // "mock" or "fedapay"
  providerRef String?            @unique // the provider's transaction ID
  requestedAt DateTime           @default(now())
  paidAt      DateTime?
  failedAt    DateTime?

  round       Round        @relation(fields: [roundId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  ledgerEntry LedgerEntry?

  @@unique([roundId, userId]) // one payment per member per round
  @@map("contributions")
}

// The group's shared record of money (D5). Lines are only ever added: the
// database itself refuses to update or delete one (see the migration
// money_in). A mistake is fixed by a CORRECTION line pointing at it.
model LedgerEntry {
  id             String          @id @default(uuid())
  groupId        String
  roundId        String?
  userId         String?         // whose money it is: the payer, or the payout's receiver
  type           LedgerEntryType
  amountFcfa     Int
  contributionId String?         @unique // a payment is written to the ledger once only
  payoutId       String?         @unique // a payout too
  correctsId     String?         @unique
  note           String?
  createdAt      DateTime        @default(now())

  group        Group         @relation(fields: [groupId], references: [id])
  round        Round?        @relation(fields: [roundId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  contribution Contribution? @relation(fields: [contributionId], references: [id])
  payout       Payout?       @relation(fields: [payoutId], references: [id])
  corrects     LedgerEntry?  @relation("Correction", fields: [correctsId], references: [id])
  correctedBy  LedgerEntry?  @relation("Correction")

  @@index([groupId, createdAt])
  @@map("ledger_entries")
}

// One round's pot, sent by the MFI to the member whose turn it is. Novi only
// instructs; the MFI holds the money and sends it (D2, D34). One payout per
// round, so a pot can never be sent twice (D49).
model Payout {
  id            String       @id @default(uuid())
  roundId       String       @unique
  beneficiaryId String
  amountFcfa    Int          // the full pot: contribution x members
  status        PayoutStatus
  phone         String       // her verified Novi number: the pot goes only to her own wallet
  operator      MobileOperator
  mfiRef        String?      // the MFI's reference for the transfer
  sentVia       String?      // D102: "fedapay" from the MFI's own account, or "mfi" through the MFI stand-in
  heldSince     DateTime?
  requestedAt   DateTime?
  paidAt        DateTime?
  // D63: the officer who released the pot, and her answer once it arrived.
  releasedById       String?
  releasedAt         DateTime?
  // D105: a pot above the MFI's limit needs two officers; the first one here.
  firstApprovedById  String?
  firstApprovedAt    DateTime?
  receiptConfirmedAt DateTime? // "I received it"
  receiptDisputedAt  DateTime? // "I did not receive it": shown to the officer
  toNextOfKin        Boolean   @default(false) // D69: sent to her next of kin after her death
  coverRepaidFcfa    Int       @default(0) // D69: her own unpaid covers, repaid from her pot first
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  round       Round        @relation(fields: [roundId], references: [id])
  beneficiary User         @relation(fields: [beneficiaryId], references: [id])
  ledgerEntry LedgerEntry?

  @@index([status])
  @@map("payouts")
}

// Every webhook a payment provider sent, kept as received. The same
// delivery sent twice has the same body, so it is recognised and ignored.
model PaymentEvent {
  id          String   @id @default(uuid())
  provider    String
  bodyHash    String   @unique // SHA-256 of the raw body
  providerRef String?
  body        Json
  receivedAt  DateTime @default(now())

  @@map("payment_events")
}


//----------------Savings record (ACEV, Sprint 6)----------------------------

// A signed snapshot of her savings record that she chose to share with a
// lender (D33, D50). The exact text that was signed is kept, so the
// signature can be checked again at any time; a single changed number makes
// it fail. She can withdraw it, and it stops working after 30 days.
model RecordShare {
  id          String    @id @default(uuid()) // also the code in the QR: 122 random bits, not guessable
  userId      String
  payloadText String    // the record as signed, JSON
  signature   String    // Ed25519 signature of payloadText, base64url
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  mfiId       String? // shared with this MFI only (D54); empty for a code any lender can open

  user  User         @relation(fields: [userId], references: [id])
  mfi   Mfi?         @relation(fields: [mfiId], references: [id])
  views RecordView[]

  @@index([userId, issuedAt])
  @@index([mfiId, issuedAt])
  @@map("record_shares")
}

// Every time a shared record is opened (D37): she can see when her record
// was looked at. For a record shared with an MFI, the officer who opened it
// is kept too (D54); for a code, no details of the viewer are kept.
model RecordView {
  id       String   @id @default(uuid())
  shareId  String
  staffId  String?
  viewedAt DateTime @default(now())

  share RecordShare @relation(fields: [shareId], references: [id])
  staff StaffUser?  @relation(fields: [staffId], references: [id])

  @@index([shareId, viewedAt])
  @@map("record_views")
}

//----------------MFI staff (Sprint 5)----------------------------

// What a staff member may do in the console. Every staff member sees only
// their own MFI's groups (D52).
enum StaffRole {
  OFFICER // sees groups, held and failed payouts, shared records; retries failed transfers
  ADMIN // the same, and later manages the MFI's staff accounts
}

// An officer of a partner MFI who uses the console. Logs in with email,
// password and a code from an authenticator app (D52). Not a member: staff
// accounts and member accounts never share a table or a token.
model StaffUser {
  id             String    @id @default(uuid())
  mfiId          String
  email          String    @unique // stored in lower case
  name           String
  role           StaffRole @default(OFFICER)
  passwordHash   String // the password itself is never stored
  totpSecret     String // base32 secret shared with the authenticator app
  lastTotpStep   Int? // the last 30-second step used, so a code works only once
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  mustChangePassword Boolean @default(false) // D81: a temporary password must be replaced at first login
  deactivatedAt  DateTime? // D81: left the agency; cannot log in
  createdAt      DateTime  @default(now())

  mfi         Mfi            @relation(fields: [mfiId], references: [id])
  sessions    StaffSession[]
  recordViews RecordView[]

  @@map("staff_users")
}

// One console login, valid for a working day. Logging out revokes it at once.
model StaffSession {
  id        String    @id @default(uuid())
  staffId   String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("staff_sessions")
}

//----------------Reminders (F16)----------------------------

// Which reminder an SMS was: the day before a due date, or the morning of it.
enum ReminderKind {
  DAY_BEFORE
  DUE_DAY
}

// One reminder sent to one member for one round. The unique key means a
// reminder is sent once, however often the job runs.
model Reminder {
  id      String       @id @default(uuid())
  roundId String
  userId  String
  kind    ReminderKind
  sentAt  DateTime     @default(now())

  round Round @relation(fields: [roundId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([roundId, userId, kind])
  @@map("reminders")
}

// D68: the group's solidarity reserve paid a member's share of one round, so
// the pot could leave full on its due date. She still owes it: her late
// payment refills the reserve.
model ReserveCover {
  id         String    @id @default(uuid())
  roundId    String
  userId     String
  amountFcfa Int       // her share of the pot: the contribution less the reserve's part
  coveredAt  DateTime  @default(now())
  repaidAt   DateTime?
  writtenOffAt DateTime? // D69: she died; nobody owes her share, the group's advances carry it (D104)
  askedAt    DateTime? // D104: she said "je ne peux pas payer ce tour" before the due date
  dueBy      DateTime? // D104: repay before this, or it counts as a missed turn
  extendedAt DateTime? // D104: the organiser gave her more time, once
  missedAt   DateTime? // D104: the deadline passed unpaid

  round Round @relation(fields: [roundId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([roundId, userId])
  @@map("reserve_covers")
}

// D68: at the end of the cycle, what is left in the reserve goes back to the
// members who owe it nothing, through the MFI, to their own number.
model ReserveReturn {
  id         String         @id @default(uuid())
  groupId    String
  userId     String
  amountFcfa Int
  phone      String
  operator   MobileOperator
  status     PayoutStatus   // SENDING, then PAID or FAILED, like a pot
  mfiRef     String?
  paidAt     DateTime?
  createdAt  DateTime       @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("reserve_returns")
}

//----------------Group chat (D70)----------------------------

enum MessageKind {
  TEXT  // written by a member
  EVENT // written by Novi when money moves, shown in each reader's language
  VOICE // a voice note recorded by a member, at most a minute
}

// One message in a group's chat. Only the group's members read it: never the
// MFI, never the console (D33). A message is never edited; the organiser or
// its author can hide it, and the group then sees that a message was hidden.
model GroupMessage {
  id         String      @id @default(uuid())
  groupId    String
  userId     String?     // the author; for an EVENT, the member it is about
  kind       MessageKind @default(TEXT)
  body       String?     // TEXT only, at most 500 characters
  voiceMs    Int?        // VOICE only: the note's length
  event      String?     // EVENT only: PAID, POT_PAID, MEETING_SCHEDULED, MEETING_CANCELLED or CALL_STARTED
  round      Int?        // EVENT only: the round number
  meetingId  String?     // EVENT only: the meeting it is about (D71)
  hiddenAt   DateTime?
  hiddenById String?
  createdAt  DateTime    @default(now())

  group    Group @relation(fields: [groupId], references: [id])
  author   User? @relation("MessageAuthor", fields: [userId], references: [id])
  hiddenBy User? @relation("MessageHider", fields: [hiddenById], references: [id])
  meeting  GroupMeeting? @relation(fields: [meetingId], references: [id])
  voice    VoiceNote?

  @@index([groupId, createdAt])
  @@map("group_messages")
}

// The sound of a voice note, kept apart so the chat pages stay light. Deleted
// when its message is hidden, and when the cycle ends: a voice is personal,
// and the group's written story is what stays.
model VoiceNote {
  messageId String   @id
  mime      String
  audio     Bytes
  createdAt DateTime @default(now())

  message GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("voice_notes")
}

//----------------Group meetings (D71)----------------------------

// A meeting the organiser schedules: an audio or video call for the whole
// group, held in a private room at the video provider (Daily). The room
// opens 10 minutes before and closes at the end; only the group's members
// get a pass to it. Nothing is recorded.
model GroupMeeting {
  id          String    @id @default(uuid())
  groupId     String
  createdById String
  title       String
  agenda      String?
  startsAt    DateTime
  durationMin Int       // 15 to 60
  instant     Boolean   @default(false) // a call a member started now, from the chat
  roomName    String?   @unique
  roomUrl     String?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  group       Group               @relation(fields: [groupId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  attendances MeetingAttendance[]
  messages    GroupMessage[]

  @@index([groupId, startsAt])
  @@map("group_meetings")
}

// Who took a pass to a meeting, for the group to see who came.
model MeetingAttendance {
  id            String   @id @default(uuid())
  meetingId     String
  userId        String
  firstJoinedAt DateTime @default(now())

  meeting GroupMeeting @relation(fields: [meetingId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@map("meeting_attendances")
}


// ---------- Help inside the group (D87, D88) and credit (D89) ----------

enum SwapStatus {
  ASKED     // she asked a member to swap turns; waiting for that member
  AGREED    // the member said yes; waiting for the organiser
  DONE      // turns swapped
  DECLINED  // the member or the organiser said no
  CANCELLED // she withdrew it, or it could no longer happen
}

// D87: two members swap their turns to receive the pot, as traders already do
// by hand. No money is lent: only who receives which round changes.
model TurnSwap {
  id             String     @id @default(uuid())
  groupId        String
  requesterId    String
  partnerId      String
  requesterRound Int        // her round before the swap
  partnerRound   Int
  status         SwapStatus @default(ASKED)
  answeredAt     DateTime?
  decidedById    String?    // the organiser who confirmed or refused
  doneAt         DateTime?
  createdAt      DateTime   @default(now())

  group     Group @relation(fields: [groupId], references: [id])
  requester User  @relation("SwapRequester", fields: [requesterId], references: [id])
  partner   User  @relation("SwapPartner", fields: [partnerId], references: [id])

  @@index([groupId, status])
  @@map("turn_swaps")
}

enum AdvanceStatus {
  ASKED     // waiting for the organiser and one more member
  APPROVED  // approved by the group; waiting for the MFI officer to send it
  SENT      // the MFI accepted the transfer
  PAID      // in her wallet; repaid from her pot on her turn
  REPAID    // her pot paid it back
  DECLINED
  CANCELLED
}

// D88: a small advance from the solidarity fund, for an emergency. At most
// one contribution, approved by the organiser and one other member, sent by
// the MFI, and repaid from her own pot on her turn, with no interest.
model Advance {
  id                 String        @id @default(uuid())
  groupId            String
  userId             String
  amountFcfa         Int
  reason             String?       // a few words for the group ("ma fille est malade")
  status             AdvanceStatus @default(ASKED)
  organiserApproval  String?       // the organiser's user id once she approved
  memberApproval     String?       // the other member who approved
  declinedById       String?
  releasedById       String?       // the officer who sent it
  mfiRef             String?
  paidAt             DateTime?
  repaidAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation("AdvanceBorrower", fields: [userId], references: [id])

  @@index([groupId, status])
  @@index([userId, status])
  @@map("advances")
}

enum LoanPurpose {
  STOCK     // buying goods to sell
  EQUIPMENT // a freezer, a stall, a sewing machine
  OTHER
}

enum LoanStatus {
  PENDING
  APPROVED    // D89, before D91: an approval that sent her to the agency (no longer given)
  PRESELECTED // D91: her record convinces the MFI; it asks for her documents
  GRANTED     // D91: decided at the agency: the MFI lends (grantedFcfa)
  NOT_GRANTED // D91: decided at the agency: no loan
  DECLINED    // refused at the first look, with a reason she reads
  WITHDRAWN
}

// D89: a microloan request to the MFI, carried by Novi with her record.
// The MFI decides and lends; Novi neither lends nor sends the money.
model LoanRequest {
  id            String      @id @default(uuid())
  userId        String
  mfiId         String
  amountFcfa    Int
  purpose       LoanPurpose
  months        Int
  status        LoanStatus  @default(PENDING)
  grantedFcfa   Int?
  decisionNote  String?     // the reason for a refusal, or the officer's note
  decidedById   String?
  decidedAt     DateTime?
  // D91: the documents the MFI asked for when it preselected her, kept as
  // they were then; her consent to send photos; when they were all checked;
  // and the outcome at the agency.
  requiredDocs       Json?
  documentsConsentAt DateTime?
  documentsCheckedAt DateTime?
  closedAt           DateTime?
  createdAt     DateTime    @default(now())

  user      User           @relation(fields: [userId], references: [id])
  mfi       Mfi            @relation(fields: [mfiId], references: [id])
  documents LoanDocument[]

  @@index([mfiId, status])
  @@index([userId, createdAt])
  @@map("loan_requests")
}

// D90: something waiting for the MFI's staff, emailed when it happens. If it
// is still waiting after 4 working hours, the administrators are emailed too.
model StaffAlert {
  id          String    @id @default(uuid())
  mfiId       String
  kind        String    // GROUP_TO_VALIDATE, POT_READY, POT_DISPUTED, LOAN_REQUEST, ADVANCE_TO_SEND, PAYMENT_REPORTED
  refId       String    // the group, payout, loan request or advance
  createdAt   DateTime  @default(now())
  escalatedAt DateTime?
  resolvedAt  DateTime?

  @@unique([kind, refId]) // one alert per thing
  @@index([mfiId, resolvedAt])
  @@map("staff_alerts")
}

// D91: the MFI's own credit conditions. Novi applies them and shows the
// evidence; the MFI decides. One row per MFI; without it, the defaults below.
model CreditPolicy {
  mfiId           String   @id
  enabled         Boolean  @default(true)
  minCycles       Int      @default(1)  // tontines completed on Novi...
  minStreak       Int      @default(8)  // ...or this many payments on time in a row
  minOnTimePct    Int      @default(90)
  ceilingTimesPot Int      @default(3)
  waitDays        Int      @default(30) // after a refusal
  months          Int[]    @default([3, 6, 12])
  documents       Json     // [{ key, label }]: what she sends once preselected
  updatedById     String?
  updatedAt       DateTime @updatedAt

  mfi Mfi @relation(fields: [mfiId], references: [id])

  @@map("credit_policies")
}

enum DocumentStatus {
  SENT     // the officer has not looked yet
  ACCEPTED
  REDO     // the officer asks for a new photo, with a note
}

// D91: a photo of one document for a preselected loan request. Seen only by
// that MFI's staff, each view logged; the photo itself is deleted 30 days
// after the file is complete or closed (data stays null, deletedAt set).
model LoanDocument {
  id           String         @id @default(uuid())
  loanId       String
  key          String         // which required document
  mime         String
  data         Bytes?
  status       DocumentStatus @default(SENT)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  loan LoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, key])
  @@map("loan_documents")
}

// Every SMS Novi sends (D109, D111): real ones count toward the monthly cost
// limit (SMS_MONTHLY_LIMIT); on the pilot (PILOT_SHOW_SMS=true) the text is
// kept too, so a tester sees in "Mes SMS" what her phone would receive.
model SmsLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  phone     String?
  text      String?
  real      Boolean  @default(true) // false: simulated, nothing left the server

  @@index([createdAt])
  @@index([phone, createdAt])
  @@map("sms_logs")
}

// D106: a sign-up by USSD in progress. A basic phone cannot read an SMS while
// a USSD session is open, so the session ends once ANID has sent its code,
// and she dials again to type it: this row carries her place between the two
// calls, for 15 minutes at most. Only the NIU's keyed hash is kept, never the
// NIU itself; the legal name comes back from ANID once the code is right.
model UssdSignup {
  phone           String    @id
  language        Language
  transactionId   String
  niuKeyedHash    String
  idConsentAt     DateTime
  legalName       String?   // set once ANID confirmed the code
  verifiedAt      DateTime?
  verifiedSession String?   // the USSD session in which the code was typed
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@map("ussd_signups")
}
