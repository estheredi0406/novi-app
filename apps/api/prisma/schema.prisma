  generator client {
    provider            = "prisma-client"
    output              = "../src/generated/prisma"
    moduleFormat        = "esm"
    importFileExtension = "js"
  }

  datasource db {
    provider = "postgresql"
  }


  //----------------Value Lists-------------------------


  //Interface languages ; follow ISO 639-1 (ee = Ewe)

  enum Language {

    EN 
    FR 
    EE
  }

  // SMS code to be sent 

  enum OtpPurpose {
    SIGN_UP
    NEW_DEVICE
    PIN_RESET
  }


// Member agrees to

enum ConsentType {
  ID_CHECK //her details may be sent to ANID FOR verification
  CREDIT_DATA_USE // her records may be used for credit not tax
  TERMS           // the Novi rules
}

// Where a group is in its life (D29). The API checks this before every
// action and refuses anything the state does not allow.
enum GroupState {
  DRAFT     // being set up; rules not yet sent
  PROPOSED  // rules sent; members deciding
  STARTING  // waiting for the MFI to open the account
  ACTIVE    // account open; contributions and payouts running
  COMPLETED // every member has received the pot once
  CANCELLED // stopped before any money moved
}

// How often members pay in.
enum Frequency {
  WEEKLY
  MONTHLY
}

// How the order of payouts is chosen.
enum PayoutOrder {
  DRAWN // Novi draws it at random when the group starts (default)
  FIXED // the organiser sets it, and everyone accepts it with the rules
}

// A member's role inside one group. Not an account type: the same person
// can organise one group and be an ordinary member of another.
enum MemberRole {
  ORGANISER
  MEMBER
}

// Where one seat is in its life.
enum SeatState {
  INVITED   // invitation sent, no answer yet
  ACCEPTED  // said yes to a version of the rules (see acceptedVersion)
  COUNTERED // asked for a change, with a note
  DECLINED  // said no; the seat is free
  REMOVED   // the organiser withdrew the invitation
}


//----------------Members and access------------


// A verified member. An account exists only after a successful identity check.


model User {
  id                String    @id @default(uuid())
  phone             String    @unique // +228 followed by 8 digits
  legalName         String    // exactly as on the ID record; used on the ACEV
  displayName       String    // what her group sees; she can change it
  market            String? // only in the case the trades in a market
  area              String
  language          Language
  pinHash           String    // argon2id; the PIN itself is never stored
  niuKeyedHash      String    @unique // stops one person opening two accounts
  idVerifiedAt      DateTime
  failedPinAttempts Int       @default(0)
  lockoutLevel      Int       @default(0) // each lockout lasts longer than the last
  lockedUntil       DateTime?
  pinChangedAt      DateTime? // stamps issued before this moment cannot reset the PIN again
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  devices     Device[]
  sessions    Session[]
  consents    Consent[]
  auditEvents AuditEvent[]

  organisedGroups Group[]        @relation("GroupOrganiser")
  memberships     Membership[]   @relation("SeatHolder")
  invitesSent     Membership[]   @relation("SeatInviter")
  rulesProposed   RulesVersion[]

  @@map("users")
}

// A phone the member has trusted, identified by the app's installation ID.
model Device {
  id             String   @id @default(uuid())
  userId         String
  installationId String
  trustedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]

  @@unique([userId, installationId])
  @@map("devices")
}

// One logged-in session. Revoking it logs the member out on that device.
model Session {
  id               String    @id @default(uuid())
  userId           String
  deviceId         String
  refreshTokenHash String    @unique // the token itself is never stored
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?   // ROTATED, LOGOUT, PIN_RESET or REUSE_DETECTED
  createdAt        DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// One SMS code sent to a phone number.
model OtpChallenge {
  id         String     @id @default(uuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String     // the code itself is never stored
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

// One identity check attempt. Exists before any account, so it is not linked
// to a user; used to block an NIU after 3 failures in 24 hours.
model IdentityCheck {
  id           String   @id @default(uuid())
  niuKeyedHash String
  phone        String
  matched      Boolean
  createdAt    DateTime @default(now())

  @@index([niuKeyedHash, createdAt])
  @@map("identity_checks")
}

// What a member agreed to, and to which version of the text.
model Consent {
  id         String      @id @default(uuid())
  userId     String
  type       ConsentType
  version    String
  acceptedAt DateTime

  user User @relation(fields: [userId], references: [id])

  @@map("consents")
}

// Append-only record of important events: who did what, and when.
model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?  // empty for events before an account exists
  type      String   // e.g. USER_REGISTERED, PIN_LOCKED
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_events")
}


//----------------Groups----------------------------

// A partner microfinance institution. It holds each group's money in an
// account it opens; Novi never holds money (D2).
model Mfi {
  id        String   @id @default(uuid())
  code      String   @unique // short name used in code and logs, e.g. FUCEC
  name      String   // shown to members on every money screen
  createdAt DateTime @default(now())

  groups Group[]

  @@map("mfis")
}

// A savings group. The rules themselves live in RulesVersion: the group only
// points to the version currently in force, so no agreed version is ever lost.
model Group {
  id             String     @id @default(uuid())
  name           String
  state          GroupState @default(DRAFT)
  currentVersion Int        @default(1) // the rules version members must accept
  mfiId          String
  organiserId    String
  mfiAccountRef  String?    // the MFI's reference for the group account, once opened
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  mfi           Mfi            @relation(fields: [mfiId], references: [id])
  organiser     User           @relation("GroupOrganiser", fields: [organiserId], references: [id])
  rulesVersions RulesVersion[]
  memberships   Membership[]

  @@index([state])
  @@map("groups")
}

// One version of a group's rules. Never edited: a change creates the next
// version, and every acceptance falls back to "not yet" (D29).
model RulesVersion {
  id           String      @id @default(uuid())
  groupId      String
  version      Int
  amountFcfa   Int         // each member's contribution, whole FCFA (D4)
  frequency    Frequency
  dueDay       Int         // WEEKLY: 1 (Monday) to 7 (Sunday); MONTHLY: 1 to 28
  size         Int         // number of members, 3 to 15 (D28)
  payoutOrder  PayoutOrder @default(DRAWN)
  proposedById String
  createdAt    DateTime    @default(now())

  group      Group @relation(fields: [groupId], references: [id])
  proposedBy User  @relation(fields: [proposedById], references: [id])

  @@unique([groupId, version])
  @@map("rules_versions")
}

// One seat in one group: who holds it, their role, and their answer to the rules.
model Membership {
  id              String     @id @default(uuid())
  groupId         String
  userId          String
  role            MemberRole @default(MEMBER)
  state           SeatState  @default(INVITED)
  acceptedVersion Int?       // the rules version she accepted; must equal the group's current version
  counterNote     String?    // what she asked to change, when COUNTERED
  payoutPosition  Int?       // her turn in the payout order, set when the group starts
  invitedById     String?    // empty for the organiser's own seat
  respondedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  group     Group @relation(fields: [groupId], references: [id])
  user      User  @relation("SeatHolder", fields: [userId], references: [id])
  invitedBy User? @relation("SeatInviter", fields: [invitedById], references: [id])

  @@unique([groupId, userId]) // one seat per person per group
  @@index([userId, state])    // her groups, for the 3-group limit (D26)
  @@map("memberships")
}