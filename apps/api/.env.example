DATABASE_URL="postgresql://novi_app:YOUR_PASSWORD@localhost:5432/novi_dev?schema=public"
JWT_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
NIU_HASH_KEY="generate the same way, a different value"
# Payments (Sprint 3). Leave PAYMENT_PROVIDER unset to use the mock.
MOCK_PAYMENTS_CONFIRM_MS="4000"
# PAYMENT_PROVIDER="fedapay"
# FEDAPAY_SECRET_KEY="sk_sandbox_REPLACE_WITH_YOUR_KEY"
# FEDAPAY_WEBHOOK_SECRET="wh_sandbox_REPLACE_WITH_YOUR_SECRET"
# Group meetings (D71). Leave unset to use the mock, whose rooms lead nowhere.
# DAILY_API_KEY="REPLACE_WITH_YOUR_DAILY_KEY"
# USSD through Africa's Talking (D73). Leave unset and the USSD address does not exist.
# USSD_CALLBACK_TOKEN="generate: node -e \"console.log(require('crypto').randomBytes(24).toString('base64url'))\""

# Phone notifications (D79), through Expo's free push service. Nothing to set
# for it to work. Optional: an Expo access token, so only this server can send
# to Novi's phones (expo.dev > Account settings > Access tokens).
# EXPO_ACCESS_TOKEN="REPLACE_WITH_YOUR_EXPO_TOKEN"
# Set to 1 to send no notification at all (they are then printed in the log).
# NOTIFICATIONS_OFF=1
