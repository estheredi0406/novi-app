{
  "name": "@novi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "prisma generate && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev && prisma generate",
    "demo:group": "tsx src/scripts/demoGroup.ts",
    "staff:create": "tsx src/scripts/createStaff.ts",
    "demo:payout": "tsx src/scripts/demoPayout.ts",
    "fedapay:probe": "tsx src/scripts/fedapayProbe.ts"
  },
  "devDependencies": {
    "@novi/shared": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "pg": "8.23.1",
    "zod": "^3.25.76"
  }
}
