# Installed packages: rebuilt by npm install
node_modules/

# Compiled output
dist/

# Expo's local cache
.expo/

# Secrets
.env
.env*
!.env.example

# Logs and system files
*.log
Thumbs.db
.DS_Store

# Prisma client: rebuilt by prisma generate
generated/
# Machine Ewe voice clips: made on each laptop by scripts/ewe_voice.py, never shipped as is
apps/mobile/assets/voice/ee/machine/

# Firebase service account keys (push notifications, D79): secret, uploaded to EAS, never committed
*firebase-adminsdk*.json

# Test reports written on request (vitest --outputFile)
test-results.json
